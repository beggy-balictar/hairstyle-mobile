## Mobile app talks to the web backend API (not directly to PostgreSQL).
## The web backend is what connects to Neon via DATABASE_URL.

# Optional: set this if you want to force a fixed backend URL.
# Leave empty for local LAN auto-detection from Expo host (recommended for local dev).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Backend API port (default 3000).
EXPO_PUBLIC_API_PORT=3000
