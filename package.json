{
  "name": "hairstyle-mobile-fe",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "start:tunnel:clear": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "fix:firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow-backend-firewall.ps1",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:aab": "npx eas build -p android --profile production --non-interactive",
    "build:apk:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk-local.ps1",
    "prebuild:android": "npx expo prebuild -p android",
    "download:mediapipe-model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-mediapipe-model.ps1",
    "dev": "expo start --lan",
    "start:stable": "expo start --lan --clear --port 8082"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-face-detector": "^13.0.2",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.23",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mediapipe": "^0.6.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-vision-camera": "^5.0.9",

    "react-native-web": "^0.21.0",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.28.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.28.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/plugin-transform-shorthand-properties": "^7.28.6",
    "@babel/plugin-transform-template-literals": "^7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "eas-cli": "^18.8.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.28.6"
  }
}
