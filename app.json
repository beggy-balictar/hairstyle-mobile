{
  "expo": {
    "name": "StyleHair",
    "slug": "hairstyle-mobile-fe",
    "scheme": "stylehair",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF1FF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.stylehair.mobile",
      "versionCode": 10,
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF1FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://192.168.254.136:3000",
      "router": {},
      "eas": {
        "projectId": "438f36bc-db25-4987-ac48-a340c999d860"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StyleHair to access your camera for face scanning and live AR try-on."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StyleHair to access your photos for hairstyle analysis."
        }
      ]
    ],
    "owner": "beggy-balictar"
  }
}
